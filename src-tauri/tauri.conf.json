{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQ Zone Restore Archive",
  "version": "1.0.9",
  "identifier": "top.ehre.qzonearchive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QQ 空间恢复归档",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*", "$APPDATA/images/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "xiaosu19",
    "category": "Utility",
    "shortDescription": "尝试从互动记录还原 QQ 空间动态，并将照片、视频与评论安全归档到本地。",
    "longDescription": "QQ Zone Restore Archive 是基于 QzoneArchive 二次开发的本地归档工具，可尝试从仍存在的互动记录中还原动态、照片、视频、点赞和评论；不保证能够恢复没有互动痕迹或已被服务端彻底清除的内容。",
    "copyright": "Copyright © 2026 xiaosu19 and QzoneArchive contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav",
          "fonts-noto-cjk"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "QQ Zone Restore Archive"
      },
      "wix": {
        "upgradeCode": "24779296-0f03-5f99-83ea-fc2fcda733b9",
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
